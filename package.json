{
    "name": "nengi",
    "version": "1.27.0",
    "description": "multiplayer game networking for node.js and html5",
    "type": "module",
    "main": "index.js",
    "browser": "indexBrowser.js",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "yalc:watch": "nodemon -x './scripts/yalc-push.sh'",
