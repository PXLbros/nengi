    "license": "Apache 2.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "dependencies": {
        "eventemitter3": "5.0.1",
        "utf8": "^3.0.0",
        "uwebsockets.js": "github:uNetworking/uWebSockets.js#v20.56.0",
        "ws": "^8.17.0"
    },
    "devDependencies": {
        "vitest": "^4.0.12",
        "yalc": "^1.0.0-pre.53",
        "nodemon": "^3.0.1"
    }
}
